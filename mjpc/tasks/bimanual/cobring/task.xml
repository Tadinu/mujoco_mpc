<mujoco model="aloha">
  <include file="../../common.xml"/>

  <size memory="1M"/>

  <asset>
    <texture name="groundplane" type="2d" builtin="flat" rgb1="0.20000000000000001 0.29999999999999999 0.40000000000000002" rgb2="0.10000000000000001 0.20000000000000001 0.29999999999999999" mark="edge" markrgb="0.50000000000000004 0.50000000000000004 0.50000000000000004" width="200" height="200"/>
    <material name="groundplane" texture="groundplane" texrepeat="2 2" texuniform="true" reflectance="0.20000000000000001"/>
  </asset>

  <custom>
    <numeric name="agent_planner" data="0" />
    <numeric name="agent_horizon" data="0.6" />
    <numeric name="agent_timestep" data="0.01" />
    <numeric name="agent_sample_width" data="0.2" />
    <numeric name="agent_policy_width" data="0.002" />
    <numeric name="sampling_exploration" data="0.1 0.6" />
    <numeric name="sampling_trajectories" data="120"/>
    <numeric name="sampling_representation" data="1" />
    <numeric name="sampling_sliding_plan" data="1" />
    <numeric name="sampling_spline_points" data="4" />
    <numeric name="gradient_spline_points" data="6" />
  </custom>

  <statistic extent="1" center="0.2 0 0.25" meansize="0.03"/>

  <option timestep="0.01"/>

  <visual>
    <quality shadowsize="8192"/>
    <global azimuth="90" elevation="-30" realtime="0.5"/>
  </visual>

  <worldbody>
    <light pos="0 -0.1 0.5" dir="0 0.2 -1" diffuse="0.7 0.7 0.7" specular="0.3 0.3 0.3"
        directional="true" castshadow="true"/>
    <!--<geom name="floor" pos="0 0 0" size="0 0 0.05" type="plane" material="groundplane"/>-->
    <body name="table" pos="0 0.5 0.25">
      <geom name="table" pos="0 0 0.6509" size="0.61 0.37 0.1" type="box"/>
      <geom name="table_visual" pos="0 0 0.6509" size="0.61 0.37 0.1" type="box" rgba="0 0 0 1" conaffinity="0" contype="0"/>
    </body>
    <body mocap="true" name="target" pos="0 0.75 1.5">
      <geom name="target" group="1" size="0.03" rgba="1 0.4 0.4 1" conaffinity="0" contype="0"/>
    </body>
    <body name="box" pos="0 0.5 1.5">
      <freejoint/>
      <geom name="box" type="box" size="0.03 0.03 0.03" condim="6" friction="1 5e-3 5e-4"
            rgba=".1 .6 .1 1" group="0"/>
    </body>
  </worldbody>

  <sensor>
    <user name="Reach L" dim="3" user="2 .1  0 .5 0.01"/>
    <user name="Reach R" dim="3" user="2 .1  0 .5 0.01"/>
    <user name="Grasp" dim="1"   user="-1 .05 0 .5"/>
    <user name="CoBring" dim="3"   user="2 .4  0 1 0.003"/>

    <framepos name="box_to_panda0_gripper" objtype="body" objname="box" reftype="site" refname="panda0_end_effector"/>
    <framepos name="box_to_panda1_gripper" objtype="body" objname="box" reftype="site" refname="panda1_end_effector"/>
    <framepos name="box" objtype="body" objname="box"/>
    <framepos name="fingerLL" objtype="body" objname="panda0_leftfinger"/>
    <framepos name="fingerLR" objtype="body" objname="panda0_rightfinger"/>
    <framepos name="fingerRL" objtype="body" objname="panda1_leftfinger"/>
    <framepos name="fingerRR" objtype="body" objname="panda1_rightfinger"/>
    <framepos name="target" objtype="body" objname="target"/>
    <framepos name="trace0" objtype="site" objname="panda0_end_effector"/>
    <framepos name="trace1" objtype="site" objname="panda1_end_effector"/>
    <framepos name="trace2" objtype="geom" objname="box"/>
  </sensor>

  <!-- This, due to also having internal <sensor> downstream, must be added after <sensor> above -->
  <include file="bi-franka_panda.xml"/>

  <default>
    <default class="grasp">
      <geom type="sphere" size="0.0006" rgba="1 0 0 1" condim="6" friction="1 5e-3 5e-4" solref=".01 1" margin=".02" gap=".02" group="3"/>
    </default>
  </default>
</mujoco>
