<mujoco model="MPL Pick">
	<include file="MPL.xml"/>
	<include file="assets.xml"/>

    <default>
        <default class="red_rgb_object/">
            <default class="red_rgb_object/visual">
                <geom contype="0" conaffinity="0" group="1" rgba="1 0 0 1" mass="0.001"/>
            </default>
            <default class="red_rgb_object/collision">
                <geom contype="1" conaffinity="1" condim="6" friction="0.2 0.005 0.0001" mass="0.2" solref="0.004 1"/>
            </default>
        </default>
    </default>

    <worldbody>
		<geom type="plane" material="MatPlane" pos=".6 0 0.1" zaxis="-1 0 1" size=".1 .5 .025"/>
		<geom type="plane" material="MatPlane" pos="-.6 0 0.1" zaxis="1 0 1" size=".1 .5 .025"/>
		<geom type="plane" material="MatPlane" pos="0 .6 0.1" zaxis="0 -1 1" size=".5 .1 .025"/>
		<geom type="plane" material="MatPlane" pos="0 -.6 0.1" zaxis="0 1 1" size=".5 .1 .025"/>

        <body name="object">
            <freejoint name="red_rgb_object/"/>
            <geom name="object" class="red_rgb_object/collision" rgba="1 0 0 1" type="box" size="0.05 0.03 0.05" pos="0 0 0.1"/>
        </body>
        <body name="target" gravcomp="1">
            <freejoint/>
            <geom name="target" rgba=".5 .5 .7 1" type="box" size="0.039 0.008 0.09" contype="0" conaffinity="0" pos="0 -0.4 0.1" quat="0.477714 -0.521334 -0.521334 -0.477714"/>
        </body>
    </worldbody>
</mujoco>
